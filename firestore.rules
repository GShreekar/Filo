rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The only accounts allowed to touch this deployment. Add an address here
    // to grant access; remove it to revoke immediately, even for a signed-in
    // session. Keep it in sync with VITE_ALLOWED_EMAILS (client UI) and
    // ALLOWED_EMAILS (the generatePDF function), which gate the same way.
    function allowedEmails() {
      return [
        'gsbksirsi@gmail.com'
      ];
    }

    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in allowedEmails();
    }

    // The stored document belongs to the caller.
    function ownsExisting() {
      return resource.data.ownerId == request.auth.uid;
    }

    // The document being written is stamped with the caller's uid. On an update
    // this also blocks reassigning ownerId to someone else.
    function ownsIncoming() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    // Field-shape checks below exist so a buggy client (or a compromised
    // allowlisted session) can't corrupt a document into something the rest
    // of the app crashes on — e.g. a missing createdAt used to crash the
    // Firestore listener before src/lib/firebase-service.ts guarded it.
    // They reject unexpected extra fields, wrong types, and oversized text.

    function isValidFolder(data) {
      return data.keys().hasOnly(['name', 'parentId', 'ownerId', 'createdAt'])
        && data.ownerId is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 300
        && (data.parentId == null || data.parentId is string)
        && data.createdAt is timestamp;
    }

    // Metadata only — no content. The sidebar/search-list listener subscribes
    // to this collection, so keeping it small is the point (2.12): a note's
    // body no longer has to download for every note just to render the list.
    //
    // revision is optional here (notes written before it existed have none)
    // and its value isn't enforced to increase monotonically — it only has
    // to be a non-negative int. It powers a client-side conflict banner
    // (5.1.3), not a security invariant, so there's nothing for the rule to
    // gain by policing it more strictly than that.
    function isValidNote(data) {
      return data.keys().hasOnly(
          ['title', 'folderId', 'ownerId', 'createdAt', 'updatedAt', 'revision']
        )
        && data.ownerId is string
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && (data.folderId == null || data.folderId is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('revision' in data) || (data.revision is int && data.revision >= 0));
    }

    // A note's body, split into its own doc (same id as the note) so it's
    // only ever read for the note that's actually open, or in the one-time
    // batched fetch that warms the client-side search cache.
    function isValidNoteContent(data) {
      return data.keys().hasOnly(['content', 'ownerId'])
        && data.ownerId is string
        // Firestore caps a document at ~1MiB total; this just leaves headroom
        // for the ownerId field instead of relying on that limit implicitly.
        && data.content is string && data.content.size() <= 900000;
    }

    // createdAt is the document's identity in time — nothing should be able
    // to rewrite it after creation, including the owner's own client.
    function createdAtUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    match /folders/{folderId} {
      allow read:   if isAllowedUser() && ownsExisting();
      allow create: if isAllowedUser() && ownsIncoming() && isValidFolder(request.resource.data);
      allow update: if isAllowedUser() && ownsExisting() && ownsIncoming()
                      && isValidFolder(request.resource.data) && createdAtUnchanged();
      allow delete: if isAllowedUser() && ownsExisting();
    }

    match /notes/{noteId} {
      allow read:   if isAllowedUser() && ownsExisting();
      allow create: if isAllowedUser() && ownsIncoming() && isValidNote(request.resource.data);
      allow update: if isAllowedUser() && ownsExisting() && ownsIncoming()
                      && isValidNote(request.resource.data) && createdAtUnchanged();
      allow delete: if isAllowedUser() && ownsExisting();
    }

    match /noteContents/{noteId} {
      allow read:   if isAllowedUser() && ownsExisting();
      allow create: if isAllowedUser() && ownsIncoming() && isValidNoteContent(request.resource.data);
      allow update: if isAllowedUser() && ownsExisting() && ownsIncoming()
                      && isValidNoteContent(request.resource.data);
      allow delete: if isAllowedUser() && ownsExisting();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
