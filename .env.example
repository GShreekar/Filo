# Firebase web app config (Project settings -> Your apps -> SDK setup and configuration).
# These are public by design; access is controlled by firestore.rules, not by hiding them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated accounts allowed to sign in. Controls the UI only.
# Keep in sync with allowedEmails() in firestore.rules, which is the real gate.
# Leave empty to let the rules decide on their own.
VITE_ALLOWED_EMAILS=

# Set to "true" only if you're running `firebase emulators:start --only functions`
# locally and want PDF export to hit it instead of the real deployed function.
VITE_USE_FUNCTIONS_EMULATOR=
